root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{ps1,cmd,bat}]
end_of_line = crlf

# Windows PowerShell 5.1 só lê acentos corretamente em UTF-8 com BOM
[*.ps1]
charset = utf-8-bom
