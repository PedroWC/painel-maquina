{
  "name": "painel-maquina",
  "version": "0.1.0",
  "description": "Painel web para gerenciar terminais, tarefas agendadas, serviços, containers e outras tecnologias em uma máquina Windows.",
  "private": true,
  "license": "MIT",
  "author": "Pedro Carvalhaes <pedro@carvalhaes.dev>",
  "main": "src/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.js",
    "gerar-token": "node scripts/gerar-token.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  }
}
